{
  "name": "termscape-root",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/hub",
    "packages/web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build -w @termscape/protocol && npm run build -w @termscape/web && npm run build -w @termscape/hub",
    "dev": "npm run dev -w @termscape/hub --",
    "dev:web": "npm run dev -w @termscape/web --",
    "test": "vitest run",
    "typecheck": "tsc -b packages/hub --pretty && tsc -p packages/web --noEmit --pretty",
    "pack:npm": "npm run build && npm run pack:npm -w @termscape/hub"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
