{
  "name": "@termscape/hub",
  "version": "0.2.0",
  "private": true,
  "description": "Run a crew of AI coding agents on one infinite canvas, and let them talk to each other.",
  "license": "MIT",
  "author": "kdonev",
  "homepage": "https://github.com/kdonev/termscape#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kdonev/termscape.git",
    "directory": "packages/hub"
  },
  "bugs": {
    "url": "https://github.com/kdonev/termscape/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "terminal",
    "canvas",
    "mcp",
    "claude-code",
    "pty",
    "tui"
  ],
  "type": "module",
  "bin": {
    "termscape": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/pack-hub.mjs",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "pack": "node scripts/pack-hub.mjs",
    "pack:npm": "node scripts/pack-npm.mjs"
  },
  "dependencies": {
    "@termscape/protocol": "*",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/headless": "^5.5.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.2.0",
    "node-pty": "1.2.0-beta.15",
    "smol-toml": "^1.3.1",
    "ssh2": "^1.16.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/ssh2": "^1.15.1",
    "@types/ws": "^8.5.13"
  },
  "files": [
    "dist",
    "!dist/hub.tgz",
    "package.json"
  ]
}
